show_startup_tips false

// Prefer showing a border, it makes Ctrl-t state much more
// obvious. This changed in Zellij 0.45.
pane_frame_style "full"

// Save sessions often and with pane contents, so they survive a reboot.
session_serialization true
serialize_pane_viewport true
scrollback_lines_to_serialize 2000
serialization_interval 60

keybinds {
    // Free Ctrl+g for programs (e.g. Claude, Emacs, zile).
    unbind "Ctrl g"

    // Free Ctrl+p for programs (e.g. Emacs and shell history).
    unbind "Ctrl p"

    shared_except "pane" "locked" {
        bind "F8" { SwitchToMode "Pane"; }
    }

    pane {
        bind "F8" { SwitchToMode "Normal"; }
    }

    tab {
        // It's too easy to press x accidentally, use F12 to
        // close the pane.
        unbind "x"
        bind "F12" { CloseTab; SwitchToMode "Normal"; }

        // Try to avoid accidentally staying in tab mode by leaving immediately after j/k.
        bind "h" "Left" "Up" "k" {
            GoToPreviousTab; SwitchToMode "Normal";
        }
        bind "l" "Right" "Down" "j" {
            GoToNextTab; SwitchToMode "Normal";
        }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }
    }

    shared_except "locked" {
        // Alt+g locks from any ordinary Zellij mode.
        bind "Alt g" { SwitchToMode "Locked"; }
    }

    // Alt+g unlocks.
    locked {
        bind "Alt g" { SwitchToMode "Normal"; }
    }
}