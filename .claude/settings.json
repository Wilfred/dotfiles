{
  "env": {
    "CLAUDE_CODE_SHELL": "/bin/bash"
  },
  "permissions": {
    "ask": [
      "Bash(rm:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "notify-send 'ClaudeCode' 'Waiting on permissions' --icon=dialog-question"
          }
        ]
      }
    ],
    "Stop": []
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  }
}
